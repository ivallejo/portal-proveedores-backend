# Web de Proveedores · Backend (API .NET 10)
# Variables de entorno de referencia para QAS y Producción.
# En IIS se configuran como variables de entorno del sitio o del pool de aplicaciones.
# Los valores entre <> son de ejemplo; los marcados [SECRETO] no deben guardarse en el repositorio.

# --- General ---
ASPNETCORE_ENVIRONMENT=Production
# URL pública del portal (enlaces de los correos)
Frontend__BaseUrl=https://<dominio-del-portal>
# Solo si el frontend y la API se publican en dominios distintos
# Cors__AllowedOrigins__0=https://<dominio-del-portal>

# --- Base de datos ---
# [SECRETO] Usuario de la aplicación con permisos de lectura y escritura (sin DDL)
ConnectionStrings__DefaultConnection=Server=<servidor>;Database=WebProveedores;User Id=<usuario>;Password=<contraseña>;TrustServerCertificate=True
# Los cambios de esquema se aplican con el script SQL entregado en cada versión
Database__ApplyMigrationsOnStartup=false

# --- Seguridad (JWT) ---
# [SECRETO] Llave aleatoria de al menos 32 caracteres, distinta en QAS y Producción
Jwt__SigningKey=<llave-aleatoria>
# Duración de la sesión en minutos (opcional, por defecto 30)
# Jwt__AccessTokenMinutes=30

# --- SAP ---
# QAS: vhnzsds4ci · Producción: vhnzsps4ci
Sap__BaseUrl=http://vhnzsps4ci.sap.navitranso.com:8000
Sap__Client=200
# [SECRETO] Credencial Basic de los servicios SAP (solo el valor Base64)
Sap__BasicToken=<token-base64>

# --- Correo (SMTP) ---
Smtp__Host=<servidor-smtp>
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=<cuenta-del-portal>
Smtp__From=<cuenta-del-portal>
# [SECRETO]
Smtp__Password=<contraseña-del-correo>
# Producción: Send (envío real). QAS: Redirect (todos los correos a Email__TestRecipient)
Email__Mode=Send
# Solo con Email__Mode=Redirect
# Email__TestRecipient=<casilla-de-pruebas>

# --- Datos iniciales ---
# Archivo con los administradores y datos iniciales (lo entrega el proveedor, fuera del repositorio)
Seed__FilePath=seed.production.json
# [SECRETO] Contraseña temporal de los usuarios iniciales; se cambia en el primer ingreso
Seed__TemporaryPassword=<contraseña-temporal>

# --- Seguridad adicional (opcional) ---
# Exigir HTTPS y trabajar detrás de un proxy inverso
# Security__RequireHttps=true
# Security__UseForwardedHeaders=true
# Bloqueo de cuenta tras intentos fallidos
# Security__MaxFailedLogins=5
# Security__LockoutMinutes=15
# Límite de solicitudes por minuto (login y operaciones sensibles)
# RateLimiting__LoginPerMinute=10
# RateLimiting__SensitivePerMinute=10
